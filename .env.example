# ================= 实时公交看板配置示例 =================
# 复制本文件为 .env 并按需修改（.env 已被 .gitignore 排除，不会提交）
# 不配置则使用仓库内置的默认演示线路（深圳 1 路 → 东湖人行天桥）

# 城市 ID（车来了城市编码，如深圳=014、北京=027、上海=034）
BUS_CITY_ID=014
BUS_CITY_NAME=深圳

# 线路 ID（通过 bus_search 获取，或运行 node src/find.js --city <cityId> --kw "线名" 查询）
BUS_LINE_ID=0755-00010-0
BUS_LINE_NO=1路

# 候车站（目标站）：
#   BUS_STOP_NAME 站名 | BUS_STOP_ORDER 站序（从1开始）| BUS_STOP_SID 站点ID(可选，可自动解析)
BUS_STOP_NAME=东湖人行天桥
BUS_STOP_ORDER=4

# 服务端口
BUS_PORT=8787

# 向上游拉取刷新间隔（毫秒，默认 10000）
BUS_UPSTREAM_MS=10000
